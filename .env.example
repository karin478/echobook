# Echobook — copy to ~/.config/kokoro-reader/.env (or point KOKORO_TRANSLATE_ENV at another file).
# Process environment variables with the same names win over this file.

# OpenRouter key: sentence translations, the 划词 讲解, and the glossary. Without it the reader
# still works (audio + highlighting), only the Chinese side is missing.
OPENROUTER_API_KEY=

# Optional
# KOKORO_TRANSLATE_MODEL=deepseek/deepseek-v4.1-flash-1017
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1
